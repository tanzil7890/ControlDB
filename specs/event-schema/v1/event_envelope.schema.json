{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controldb.dev/specs/event-schema/v1/event_envelope.schema.json",
  "title": "ControlDB Event Envelope",
  "type": "object",
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "org_id",
    "project_id",
    "environment",
    "agent_id",
    "run_id",
    "actor",
    "payload_mode",
    "event_hash",
    "occurred_at",
    "ingested_at"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "event_type": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+){1,3}$"},
    "org_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["dev", "staging", "prod"]},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_version": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "step_id": {"type": ["string", "null"]},
    "step_index": {"type": ["integer", "null"], "minimum": 0},
    "trace_id": {"type": ["string", "null"]},
    "span_id": {"type": ["string", "null"]},
    "parent_span_id": {"type": ["string", "null"]},
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"type": "string", "enum": ["agent", "human", "system"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "payload_mode": {
      "type": "string",
      "enum": ["metadata_only", "hash_only", "redacted_payload", "full_payload", "self_hosted_payload"]
    },
    "payload": {"type": ["object", "null"]},
    "payload_hash": {"type": ["string", "null"]},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": ["string", "null"]}
  }
}
